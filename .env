# ----------------------------
# Base de datos
# ----------------------------
# Conexión PostgreSQL que usa api-backend/db/database.py
# Reemplaza con tu conexión Neon real.
DATABASE_URL=postgresql://<NEON_USER>:<NEON_PASSWORD>@<NEON_HOST>/<NEON_DB>?sslmode=require&channel_binding=require

# Si usas también el servicio de Postgres local definido en docker-compose:
POSTGRES_USER=pi_user
POSTGRES_PASSWORD=pi_pass
POSTGRES_DB=pi_db

# ----------------------------
# Backend (api-backend)
# ----------------------------
# La API FastAPI usa DATABASE_URL en api-backend/db/database.py.
# Si deseas que el backend use un secreto JWT desde entorno,
# deberías cambiar api-backend/auth/jwt_handler.py para leerlo.
# JWT_SECRET_KEY=replace-with-very-secure-random-string
# JWT_ALGORITHM=HS256

# ----------------------------
# Admin web (Flask)
# ----------------------------
# URL interna del backend que consume admin-web/utils.py
FASTAPI_URL=http://api-backend:8000

# Flask runtime
FLASK_ENV=production
FLASK_DEBUG=0

# Nota: admin-web/app.py actualmente fija app.secret_key="123456" en el código.
# Para producción es mejor mover esto a una variable de entorno como:
# FLASK_SECRET_KEY=replace-with-secure-random-string

# ----------------------------
# Frontend móvil / Expo
# ----------------------------
# API pública que usa mobile-app/config/api.js cuando EXPO_PUBLIC_API_BASE_URL está definido
EXPO_PUBLIC_API_BASE_URL=http://api-backend:8000

# Variables de Expo necesarias en docker-compose
EXPO_USE_V2_RESOLVER=1
REACT_NATIVE_PACKAGER_HOSTNAME=<TU_IP_O_HOSTNAME>

# ----------------------------
# Observabilidad / monitoreo
# ----------------------------
# Si quieres externalizar la contraseña de Grafana en el despliegue
GF_SECURITY_ADMIN_PASSWORD=admin